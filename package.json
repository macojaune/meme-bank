{
  "name": "memebank-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "node ace serve --hmr",
    "dev:raycast": "pnpm --dir apps/raycast dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@memebank/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --env-mode=loose",
    "lint": "turbo run lint",
    "format": "pnpm --filter @memebank/web format",
    "start": "node apps/web/build/bin/server.js"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  }
}
